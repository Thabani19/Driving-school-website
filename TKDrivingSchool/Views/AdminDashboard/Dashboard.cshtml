@model TKDrivingSchool.Controllers.AdminDashboardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* ============================================
       RESET & BASE
    ============================================ */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f0f2f5;
    }

    /* ============================================
       SIDEBAR - Dark Navy
    ============================================ */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 240px;
        height: 100vh;
        background: #1a2332;
        color: #fff;
        padding: 0;
        z-index: 1000;
        overflow-y: auto;
    }

    .sidebar-brand {
        padding: 25px 20px 20px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

        .sidebar-brand h3 {
            font-size: 22px;
            font-weight: 700;
            margin: 0;
            color: #fff;
            letter-spacing: 0.5px;
        }

            .sidebar-brand h3 span {
                color: #4fc3f7;
            }

        .sidebar-brand small {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.5);
            display: block;
            margin-top: 2px;
            font-weight: 400;
        }

    .sidebar-nav {
        list-style: none;
        padding: 15px 0;
        margin: 0;
    }

        .sidebar-nav li {
            padding: 0 15px;
            margin-bottom: 2px;
        }

            .sidebar-nav li a {
                display: flex;
                align-items: center;
                padding: 12px 15px;
                color: rgba(255, 255, 255, 0.6);
                text-decoration: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.2s;
            }

                .sidebar-nav li a:hover {
                    background: rgba(255, 255, 255, 0.06);
                    color: #fff;
                }

                .sidebar-nav li a.active {
                    background: rgba(79, 195, 247, 0.12);
                    color: #4fc3f7;
                }

                .sidebar-nav li a i {
                    width: 20px;
                    margin-right: 12px;
                    font-size: 15px;
                    text-align: center;
                }

    /* ============================================
       MAIN CONTENT
    ============================================ */
    .main-content {
        margin-left: 240px;
        padding: 25px 30px;
        min-height: 100vh;
    }

    /* ============================================
       HEADER
    ============================================ */
    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            font-size: 26px;
            font-weight: 700;
            color: #1a2332;
            margin: 0;
        }

            .page-header h1 small {
                font-size: 14px;
                font-weight: 400;
                color: #8898aa;
                display: block;
                margin-top: 2px;
            }

    /* ============================================
       TAB NAV - Simple Underline Tabs
    ============================================ */
    .tab-nav {
        display: flex;
        gap: 0;
        border-bottom: 2px solid #e8ecf1;
        margin-bottom: 25px;
        background: transparent;
    }

        .tab-nav a {
            padding: 10px 20px;
            color: #8898aa;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all 0.2s;
        }

            .tab-nav a:hover {
                color: #1a2332;
            }

            .tab-nav a.active {
                color: #4fc3f7;
                border-bottom-color: #4fc3f7;
            }

            .tab-nav a i {
                margin-right: 6px;
                font-size: 13px;
            }

    /* ============================================
       STATS GRID - Clean Cards
    ============================================ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #fff;
        border-radius: 8px;
        padding: 14px 18px;
        border: 1px solid #e8ecf1;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

        .stat-card .stat-label {
            font-size: 12px;
            font-weight: 600;
            color: #8898aa;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .stat-card .stat-value {
            font-size: 22px;
            font-weight: 700;
            color: #1a2332;
            margin-top: 2px;
        }

            .stat-card .stat-value.green {
                color: #2ecc71;
            }

            .stat-card .stat-value.blue {
                color: #3498db;
            }

            .stat-card .stat-value.orange {
                color: #f39c12;
            }

            .stat-card .stat-value.red {
                color: #e74c3c;
            }

            .stat-card .stat-value.purple {
                color: #9b59b6;
            }

    /* ============================================
       ACTIVITY SECTION - Clean List
    ============================================ */
    .section-card {
        background: #fff;
        border-radius: 8px;
        border: 1px solid #e8ecf1;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

        .section-card .section-header {
            padding: 14px 20px;
            border-bottom: 1px solid #e8ecf1;
        }

            .section-card .section-header h5 {
                font-size: 14px;
                font-weight: 600;
                color: #1a2332;
                margin: 0;
            }

                .section-card .section-header h5 i {
                    margin-right: 8px;
                    color: #4fc3f7;
                }

        .section-card .section-body {
            padding: 10px 20px;
        }

    .activity-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f1f3f5;
    }

        .activity-item:last-child {
            border-bottom: none;
        }

        .activity-item .activity-text {
            font-size: 14px;
            color: #333;
        }

            .activity-item .activity-text i {
                width: 24px;
                color: #4fc3f7;
                font-size: 14px;
            }

            .activity-item .activity-text strong {
                font-weight: 600;
                color: #1a2332;
            }

        .activity-item .activity-time {
            font-size: 12px;
            color: #8898aa;
            background: #f1f3f5;
            padding: 2px 12px;
            border-radius: 12px;
            white-space: nowrap;
        }

    /* ============================================
       RESPONSIVE
    ============================================ */
    @@media screen and (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media screen and (max-width: 992px) {
        .sidebar {
            width: 60px;
        }

        .sidebar-brand h3,
        .sidebar-brand small,
        .sidebar-nav li a span {
            display: none;
        }

        .sidebar-nav li a {
            justify-content: center;
            padding: 12px;
        }

            .sidebar-nav li a i {
                margin-right: 0;
                font-size: 18px;
            }

        .main-content {
            margin-left: 60px;
            padding: 15px;
        }
    }

    @@media screen and (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .tab-nav a {
            padding: 8px 14px;
            font-size: 13px;
        }
    }

    @@media screen and (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .tab-nav a {
            font-size: 11px;
            padding: 6px 10px;
        }

            .tab-nav a i {
                margin-right: 4px;
            }

        .page-header h1 {
            font-size: 20px;
        }
    }
</style>

<!-- ============================================
     SIDEBAR
============================================ -->
<div class="sidebar">
    <div class="sidebar-brand">
        <h3>🚗 <span>TK</span> Driving</h3>
        <small>Administration</small>
    </div>
    <ul class="sidebar-nav">
        <li><a href="#" class="active"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
        <li><a href="@Url.Action("Index", "Students")"><i class="fas fa-users"></i> <span>Users</span></a></li>
        <li><a href="@Url.Action("Index", "Bookings")"><i class="fas fa-calendar-check"></i> <span>Bookings</span></a></li>
        <li><a href="@Url.Action("Index", "Vehicles")"><i class="fas fa-car"></i> <span>Fleet</span></a></li>
        <li><a href="@Url.Action("Index", "Payments")"><i class="fas fa-credit-card"></i> <span>Payments</span></a></li>
        <li><a href="@Url.Action("Index", "Reviews")"><i class="fas fa-star"></i> <span>Reviews</span></a></li>
        <li><a href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar"></i> <span>Reports</span></a></li>
    </ul>
</div>

<!-- ============================================
     MAIN CONTENT
============================================ -->
<div class="main-content">

    <!-- Header -->
    <div class="page-header">
        <h1>
            Administration
            <small>Users, fleet, bookings, payments, reviews and reports</small>
        </h1>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav">
        <a href="#" class="active"><i class="fas fa-chart-pie"></i> Dashboard</a>
        <a href="@Url.Action("Index", "Students")"><i class="fas fa-users"></i> Users</a>
        <a href="@Url.Action("Index", "Bookings")"><i class="fas fa-calendar-check"></i> Bookings</a>
        <a href="@Url.Action("Index", "Vehicles")"><i class="fas fa-car"></i> Fleet</a>
        <a href="@Url.Action("Index", "Payments")"><i class="fas fa-credit-card"></i> Payments</a>
        <a href="@Url.Action("Index", "Reviews")"><i class="fas fa-star"></i> Reviews</a>
        <a href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar"></i> Reports</a>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Row 1 -->
        <div class="stat-card">
            <div class="stat-label">Revenue Collected</div>
            <div class="stat-value green">R@(Model.TotalRevenue.ToString("N2"))</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value orange">R0.00</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Bookings</div>
            <div class="stat-value blue">@Model.TotalBookings</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Upcoming Lessons</div>
            <div class="stat-value purple">@Model.TodayBookings</div>
        </div>

        <!-- Row 2 -->
        <div class="stat-card">
            <div class="stat-label">Completed</div>
            <div class="stat-value green">@(Model.TotalBookings - Model.PendingBookings)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Cancelled</div>
            <div class="stat-value red">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Absences</div>
            <div class="stat-value orange">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Fleet</div>
            <div class="stat-value blue">@Model.TotalVehicles</div>
        </div>

        <!-- Row 3 -->
        <div class="stat-card">
            <div class="stat-label">Students</div>
            <div class="stat-value">@Model.TotalStudents</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Instructors</div>
            <div class="stat-value">@Model.TotalInstructors</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Avg Instructor Rating</div>
            <div class="stat-value orange">0.0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Avg Vehicle Rating</div>
            <div class="stat-value orange">0.0</div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="section-card">
        <div class="section-header">
            <h5><i class="fas fa-clock"></i> Recent Activity</h5>
        </div>
        <div class="section-body">
            @if (Model.RecentActivities != null && Model.RecentActivities.Any())
            {
                foreach (var activity in Model.RecentActivities)
                {
                    <div class="activity-item">
                        <div class="activity-text">
                            <i class="fas @activity.Icon"></i>
                            @Html.Raw(activity.Description)
                        </div>
                        <span class="activity-time">@activity.TimeAgo</span>
                    </div>
                }
            }
            else
            {
                <p style="text-align:center; color:#8898aa; padding:15px 0; font-size:14px;">No recent activity</p>
            }
        </div>
    </div>

</div>