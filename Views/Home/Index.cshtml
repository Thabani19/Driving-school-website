<!DOCTYPE html>
@{
    Layout = null;
    ViewBag.Title = "TK Driving School — Learn to drive with confidence";
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TK Driving School — Learn to drive with confidence</title>
    <meta name="description" content="Book driving lessons online, get an instructor assigned automatically, pay securely and track your progress to test-ready." />

    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/styles.css" />
</head>
<body>

    <!-- Hazard stripe accent -->
    <div class="hazard-stripe"></div>

    <!-- Header / Nav -->
    <header class="container nav">
        <div class="brand">
            <span class="logo">TK</span>
            <span class="brand-name">Driving School</span>
        </div>
        <a href="auth.html" class="btn">Sign in</a>
    </header>

    <!-- Hero -->
    <section class="hero">
        <img src="~/Content/images/hero-road.jpg" alt="Learner driving school car on a city road at dusk" />        <div class="hero-content">
            <p class="hero-eyebrow">Licensed · Insured · Since 2009</p>
            <h1>
                Learn to drive.
                <span class="text-primary">Book it in sixty seconds.</span>
            </h1>
            <p class="hero-sub">
                TK Driving School puts your lessons, instructor, payments and progress in one place —
                no phone calls, no paperwork.
            </p>
            <a href="auth.html" class="btn btn-lg">Start learning</a>
        </div>
    </section>

    <!-- Features -->
    <section class="container features">
        <h2>Everything the school runs on</h2>
        <div class="features-grid">

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4" /><path d="M16 2v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /><path d="M8 14h.01" /><path d="M12 14h.01" /><path d="M16 14h.01" /><path d="M8 18h.01" /><path d="M12 18h.01" /><path d="M16 18h.01" /></svg>
                <h3>Instant booking</h3>
                <p>Pick a slot between 08:00 and 16:00 and an available instructor and vehicle are assigned automatically.</p>
            </div>

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                <h3>Simple payments</h3>
                <p>Pay per lesson or enrol in a course package, with a full receipt history on your account.</p>
            </div>

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4" /><path d="M3.34 19a10 10 0 1 1 17.32 0" /></svg>
                <h3>Progress tracking</h3>
                <p>Hours behind the wheel, completed lessons and instructor feedback after every session.</p>
            </div>

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                <h3>Qualified instructors</h3>
                <p>Patient, licensed instructors who log your attendance and coach you toward the test.</p>
            </div>

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                <h3>Rate everything</h3>
                <p>Review your instructor, the vehicle and the service so the school keeps improving.</p>
            </div>

            <div class="feature-card">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>
                <h3>Maintained fleet</h3>
                <p>Manual and automatic vehicles, tracked and serviced by the school administrators.</p>
            </div>

        </div>
    </section>

    <!-- CTA -->
    <section class="cta">
        <div class="container cta-inner">
            <div>
                <h2>Ready for your first lesson?</h2>
                <p>Create an account and book a slot today.</p>
            </div>
            <a href="auth.html" class="btn btn-lg">Create an account</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="container footer">
        © <span id="year"></span> TK Driving School. Student, instructor and administrator portal.
    </footer>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
</body>
</html>
